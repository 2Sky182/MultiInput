<Window x:Class="MouseMuxOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseMux — Mausverwaltung"
        Width="1080"
        Height="680"
        MinWidth="850"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#11141B"
        Foreground="#E8ECF4"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1F2A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B3241"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8D98AD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#62D6A5"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#252C3A"/>
            <Setter Property="Foreground" Value="#E8ECF4"/>
            <Setter Property="BorderBrush" Value="#343D50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202634"/>
            <Setter Property="Foreground" Value="#929DB2"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#303849"/>
            <Setter Property="Padding" Value="12,13"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Mausverwaltung"
                           FontSize="27"
                           FontWeight="SemiBold"/>

                <TextBlock Text=""
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#202A30"
                    BorderBrush="#315444"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <Button Style="{StaticResource ActionButton}"
                        Content="MultiInput.exe stoppen/starten"
                        Click="KillMulti_Click">
                </Button>
            </Border>
        </Grid>

        <!-- Kennzahlen -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,0,0,20">

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,203,0">
                <StackPanel>
                    <TextBlock Text="ERKANNTE MÄUSE"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalMiceText"
                               Text="{Binding MiceCount}"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Margin="-182,0,360,0">
                <StackPanel>
                    <TextBlock Text="VERKNÜPFTE TASTATUREN"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="LinkedMiceText"
                               Text="0"
                               Foreground="#62D6A5"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

          
        </UniformGrid>

        <!-- Geräteübersicht -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="11"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Verfügbare Geräte"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeviceCountText"
                                   Text="0 Geräte"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="MiceGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding Mice}"
                          SelectedItem="{Binding SelectedMouse, Mode=TwoWay}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{StaticResource PanelBrush}"
                          Foreground="#E8ECF4"
                          BorderThickness="0"
                          RowBackground="#1A1F2A"
                          AlternatingRowBackground="#1D2330"
                          HorizontalGridLinesBrush="#252C39"
                          VerticalGridLinesBrush="Transparent"
                          ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                          SelectionChanged="MiceGrid_SelectionChanged"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="FARBE"
                                                Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="19"
                                            Height="19"
                                            CornerRadius="6"
                                            Background="{Binding ColorBrush}"
                                            BorderBrush="#667080"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="GERÄT"
                                            Binding="{Binding DeviceText}"
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="POSITION"
                                            Binding="{Binding PositionText}"
                                            Width="110"/>

                        <DataGridTextColumn Header="DELTA"
                                            Binding="{Binding DeltaText}"
                                            Width="100"/>

                        <DataGridTextColumn Header="TASTE"
                                            Binding="{Binding ButtonsText}"
                                            Width="130"/>

                        <DataGridTextColumn Header="WHEEL"
                                            Binding="{Binding Wheel}"
                                            Width="65"/>

                        <DataGridTemplateColumn Header="STATUS"
                                                Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBackground}"
                                            CornerRadius="5"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusForeground}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Detailbereich -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>



            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <CheckBox Content="Hide Cursor"
                          x:Name="cursorCheck"
                          FontSize="20"
                          Foreground="White"
                          IsChecked="True"
                          Checked="CursorHide_Checked"
                          Unchecked="CursorHide_UnChecked" Width="144"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
